# IROTE Environment Variables
# Copy this file to .env and fill in your actual values
# DO NOT commit .env to git!

# MiMo API Token (required)
MIMO_AUTH_TOKEN=tp-your-token-here

# Azure OpenAI (optional, for GPT-4o)
# GPT_ENDPOINT=https://your-resource.openai.azure.com/
# AZURE_OPENAI_API_KEY=your-azure-key
# OPENAI_API_KEY=your-openai-key

# SimCSE Model Path (optional, only if USE_SIMCSE=True)
# IROTE_SIMCSE_PATH=/path/to/sup-simcse-roberta-large
